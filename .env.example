# Скопіюйте як .env АБО використовуйте КЛЮЧІ.template.ini → КЛЮЧІ.ini + apply_keys.bat
# Детально: ОПЕРАТОР.md · scripts/apply_secrets.py

# ── Обов'язково ───────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── LLM / зображення (опційно) ────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.stability.ai/account/keys
STABILITY_API_KEY=
# https://replicate.com/account/api-tokens  (pip install replicate)
REPLICATE_API_TOKEN=
# Модель Flux для Final-рівня якості (Q1.3). Дефолт: black-forest-labs/flux-dev
FLUX_MODEL_FINAL=

# ── Gremlin Passport ↔ W3IR ───────────────────────────────────────────────────
# Спільний секрет для /gremlin/generate і /gremlin/holder (server-to-server).
# Той самий рядок, що W3IR_API_KEY у Gremlin Passport .env.local. Не заданий →
# обидва ендпоінти fail-closed (503). Згенерувати:
#   python -c "import secrets;print(secrets.token_hex(32))"
GREMLIN_API_KEY=
# GREMLIN_GENERATE_RATE_LIMIT=10
# GREMLIN_HOLDER_RATE_LIMIT=60

# ── B2B API (партнери) ────────────────────────────────────────────────────────
# Ключі видає `python scripts/grant_b2b_key.py --client "<name>" --quota <N>` і
# зберігає в users.db; тут задавати нічого не треба. W3IR_B2B_KEYS — аварійний
# обхід (кома-розділений список), що дає БЕЗЛІМІТНУ квоту без обліку: тримай
# порожнім, поки не треба пустити партнера повз БД.
# W3IR_B2B_KEYS=
# Стеля завантаження для /api/v1/launchpad/inspect-bundle (МБ) і IP-ліміт:
# LAUNCHPAD_MAX_UPLOAD_MB=25
# LAUNCHPAD_RATE_LIMIT=30
# /api/vault/status публічний і б'є в Solana-RPC на кожен запит — IP-ліміт/хв:
# VAULT_STATUS_RATE_LIMIT=60

# ── Моніторинг бекапів ────────────────────────────────────────────────────────
# daily_health_check алертить у Telegram, якщо найновішому бекапу більше N годин
# (дефолт 2 — погодинний cron із запасом). BACKUP_CHECK_DIR — якщо тека не
# стандартна backups/hourly.
# BACKUP_MAX_AGE_HOURS=2
# BACKUP_CHECK_DIR=

# daily_health_check також алертить, якщо двигун генерації почав масово падати:
# частка збоїв >= N% на вибірці >= M генерацій за добу. Дефолти 20% / 5 — здорові
# двигуни в проді тримають 0.3-0.4%, тож поріг ловить катастрофу (вилучена з API
# модель, протухлий ключ, нульовий баланс), а не звичайний шум. Кредити за збій
# повертаються, тож інші осі моніторингу такого не бачать.
# PROVIDER_FAILURE_THRESHOLD_PCT=20
# PROVIDER_MIN_ATTEMPTS=5

# Активна проба двигунів (services/provider_probe.py, теж у daily_health_check).
# Перевірка вище рахує збої в БД, тож при нульовому трафіку вона сліпа — вибірка
# не набереться ніколи. Проба питає постачальника напряму: чи живий ключ, чи не
# вилучено модель (GET /v1/models/dall-e-3 → 404 «does not exist» — саме так і
# помер DALL-E 3), чи не вичерпано баланс. Запити безкоштовні, тому ввімкнено
# за замовчуванням; вимикач — рівно "0".
# PROVIDER_PROBE_ENABLED=1
# PROVIDER_PROBE_MIN_CREDITS=50      # нижче — WARN; 0 кредитів — FAIL
# ГЛИБОКА проба реальною генерацією — платна (~$0.10 за прогін), тому строго
# opt-in і НЕ для щоденного циклу. Вмикати свідомо, напр. перед релізом.
# PROVIDER_PROBE_GENERATE=1

# Pull-бекап прод-БД на машину оператора (scripts/pull_prod_backup.py) — працює на
# наявному SSH-ключі, без хмарних облікових даних. Дефолти беруться з приватної
# конфігурації розгортання (host / тека / 30 копій у backups/offsite-prod/).
# PROD_BACKUP_HOST=user@your-host
# PROD_BACKUP_DIR=/srv/app/backups/hourly
# PROD_BACKUP_DEST=
# PROD_BACKUP_KEEP=30

# ── IPFS ──────────────────────────────────────────────────────────────────────
# https://app.pinata.cloud/developers/api-keys
PINATA_JWT=

# ── Helio Pay (білінг кредитів, USDC Base) ────────────────────────────────────
# https://app.hel.io/settings/api
HELIO_API_KEY=
HELIO_API_SECRET=
HELIO_PAYLINK_START=
HELIO_PAYLINK_CREATOR=
HELIO_PAYLINK_PRO=
HELIO_WEBHOOK_SECRET=
# Період фонового звіряння платежів у api_server (сек). Страхує пропуски webhook:
# підбирає платежі, що надійшли поки сервіс лежав/timeout від Helio. 0 = вимкнути
# (лишається webhook). Незалежний шар — scripts/reconcile_payments.py через cron.
HELIO_RECONCILE_INTERVAL_SECONDS=300

# ── Мережа / тунель ───────────────────────────────────────────────────────────
W3IR_ORIGIN=https://w3ir.io
W3IR_APP_URL=https://ai.w3ir.io
# Solana RPC для holder bonus (server-side). Пріоритет: SOLANA_RPC_URL → ALCHEMY_API_KEY.
# Скопіюйте ключ з minter: scripts/sync-alchemy-to-promt.ps1 (Sugar) або вставте URL Alchemy.
# ALCHEMY_API_KEY=
# GENESIS_RPC_ORIGIN=https://mint.w3ir.io
# Sybil-захист вітальних кредитів: 1 — вимагати мін. нативний баланс (EVM: ETH на
# Base; Solana: SOL); 0 — вимкнути перевірку (видавати всім). Для публіки лиши 1.
WELCOME_REQUIRE_BALANCE=1
# Attribution «Made with w3ir» у експорт-бандлі (README + created_with у метаданих,
# крім Metaplex). Дефолт увімкнено; 0 — вимкнути (напр. для платних тарифів).
EXPORT_ATTRIBUTION=1
# Реферальна петля (G3.3): бонус-кредити рефереру за ПЕРШУ оплату запрошеного
# (?ref=<wallet>). Дефолт 50; 0 — вимкнути реферальні нарахування.
REFERRAL_BONUS_CREDITS=50

# ── Abuse-захист публічного застосунку (ПЛАН_ЗАПОЗИЧЕНЬ B1–B3) ────────────────
# B1: content-safety блоклист промптів (CSAM/сексуальне насильство). Увімкнено
# за замовчуванням; вимикається рівно "0". На публіці лиши ввімкненим.
CONTENT_SAFETY_ENABLED=1
# B3: денна стеля генерацій для welcome-only (без Helio/grant). 0=вимкнено (рекомендовано
# при WELCOME_CREDITS=5 — баланс і так обмежує). Увімкни 15–30 лише якщо піднімеш welcome
# або відкриєш публічний фарм-вектор. Поповнені гаманці звільнені автоматично.
FREEMIUM_DAILY_LIMIT=0
# Welcome-only: стеля генерацій/хв (поповнені Helio/grant — без цього ліміту).
GENERATION_RATE_LIMIT_PER_MINUTE=10
# Workspace: ліміти pipeline-проєктів (0=вимкнено). Платники звільнені від ліміту КІЛЬКОСТІ;
# MB-ліміт — для всіх. Моніторинг — 🛠 Адмін → Ops → Workspace на диску.
WORKSPACE_MAX_PROJECTS_PER_WALLET=0
WORKSPACE_MAX_MB_PER_WALLET=0
WORKSPACE_PROJECT_WARN_COUNT=15
# Storage-GC (scripts/storage_gc.py, завдання W3IR-Storage-GC): прибирання
# РЕГЕНЕРОВАНИХ ефемерних тек data/exports (ZIP-бандли) і data/previews (прев'ю).
# Метрика диска + Telegram-алерт при перевищенні порога — завжди (read-only).
# Реальне видалення вмикається РІВНО "1" (дефолт off, безпечно); TTL у днях.
STORAGE_GC_ENABLED=0
STORAGE_GC_TTL_DAYS=14
STORAGE_DISK_WARN_PCT=80
# Metadata-бекап (scripts/metadata_backup.py, W3IR-Metadata-Backup): дзеркалить
# JSON-метадані проєктів (manifest/state) у ПРИВАТНИЙ GitHub-репо (напрацювання
# користувачів — на GitHub; критичні DB — на Proton; PNG не бекапимо, відтворні).
# Одноразово: git clone <private-url> backups/metadata-repo. Вмикається рівно "1".
METADATA_BACKUP_ENABLED=0
# B2: каскадний fallback двигунів — при падінні обраного пробує наступний ГОТОВИЙ
# (порядок: gpt-image-1 → Stability → Flux). =1 вмикає; дефолт вимкнено (бо каскад
# може згенерувати іншим, можливо дорожчим, двигуном — кредити звіряються за фактом).
IMAGE_CASCADE_ENABLED=

# ── SIWE Login Gateway (login.html → FastAPI → HMAC-сесія) ────────────────────
# Секрет для підпису сесійних токенів — ОБОВ'ЯЗКОВИЙ для роботи гейтвея.
AUTH_SESSION_SECRET=
# Канонічні поля EIP-4361 повідомлення (дефолти під ai.w3ir.io / Base mainnet)
AUTH_DOMAIN=ai.w3ir.io
AUTH_URI=https://ai.w3ir.io
AUTH_CHAIN_ID=8453
# Гард у Streamlit: =1 вмикає примусовий вхід (дефолт вимкнено — периметр Cloudflare)
AUTH_GATEWAY_ENFORCE=
AUTH_GATEWAY_URL=https://ai.w3ir.io/login
# Мова UI Streamlit за замовчуванням: en (публічний сайт) | uk (оператор локально)
UI_DEFAULT_LANG=en
# Адмін-гаманці через кому — вкладка «🛠 Адмін» (без bypass білінгу)
ADMIN_WALLETS=
# Операторський гаманець (= перший ADMIN_WALLETS): grant для QA. Helio dogfood — можна відкласти.
OPERATOR_WALLET=
OPERATOR_GRANT_DEFAULT=400
# Власні гаманці для dogfood (через кому): платять РЕАЛЬНИМИ грошима, тож без
# цього списку самоплатежі читаються у звітах як зовнішній попит, а guard
# «зовнішнього трафіку» в e67_gate_check закривається власними руками.
# Метрики: stats.overview/funnel/quality_summary, margin_report (services/wallet_class).
DOGFOOD_WALLETS=
# Nonce-стор гейтвея: memory (дефолт, in-memory — потребує uvicorn --workers 1)
# або redis (спільний між воркерами — дозволяє --workers >1). Потребує пакет redis.
AUTH_NONCE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# ── Моніторинг / алерти (вотчдог scripts/watchdog.py) ─────────────────────────
# Telegram-бот для сповіщень про збій служби (через @BotFather → токен; chat_id —
# напр. через @userinfobot). Якщо порожні — Telegram-алерти вимкнено.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Альтернатива/додатково: generic-вебхук (POST JSON при збої) — Discord/Slack/власний.
HEALTH_ALERT_WEBHOOK=
# Поріг низького балансу Stability (кредити) для Telegram-алерту (scripts/admin_telegram.py).
STABILITY_LOW_BALANCE=100

# ── Чиста маржа (адмін → Економіка) ───────────────────────────────────────────
# Параметри рядка «Чиста маржа = валова − комісії − обмін − фікс». Усі опційні.
PAYMENT_FEE_PCT=1.0        # комісія Helio з кожної оплати, %
FX_FEE_PCT=2.0             # обмін USDC→фіат (off-ramp+spread) для поповнення провайдерів, %
FIXED_MONTHLY_USD=0.0      # фіксовані витрати/міс (хостинг+домен); 0 = self-host

# ── Dev / тести ───────────────────────────────────────────────────────────────
# Локально: APP_ENV=development (або не задавати)
# VPS:     APP_ENV=production  (обов'язково — блокує simulate_payment)
APP_ENV=
# ENABLE_SIM_PAYMENTS=1 — імітація оплати в UI (лише dev; на prod не вмикати)

# ── Genesis holder bonus (services/holder_rewards.py) ──────────────────────────
# Власники W3IR Genesis Avatar отримують бонусні кредити. Усі мають дефолти —
# фіча працює без задання. Список mint'ів: data/genesis_mints.json
# (оновлюється C:\Sugar\scripts\snapshot-holders.mjs після нових мінтів).
GENESIS_COLLECTION_MINT=6YRxC2pwqttw11zy4v2cGgV3DztpPX7zSHrFFcA4nmqC
GENESIS_BONUS_CREDITS=50         # базовий бонус на гаманець
GENESIS_BONUS_PER_EXTRA=25       # +за кожен NFT понад перший
GENESIS_BONUS_MAX=150            # стеля на гаманець (анти-Сібіл)
GENESIS_BONUS_PERIOD=once        # once = разово · monthly = щомісяця
GENESIS_BONUS_BUDGET=5000        # глобальна стеля кредитів (захист маржі)
# Командні гаманці без бонусу (дефолт: deployer + treasury). Через кому.
# GENESIS_BONUS_EXCLUDE_WALLETS=DE1gBEaqA11uYdySmF5LRmN8QsvXvnYJYHDVXeAY15Vh,63u6SDZckvzcJhC4V5yJn6bZ15qx1iM8c6iB3Z9xD1tn
